{
  "info": {
    "name": "Raízes do Nordeste API",
    "description": "Collection para testar todas as rotas da API do projeto",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8000" },
    { "key": "token", "value": "" },
    { "key": "pedidoId", "value": "1" }
  ],
  "item": [
    {
      "name": "Home",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": ["{{baseUrl}}"],
          "path": [""]
        }
      }
    },
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const jsonData = JSON.parse(responseBody);",
              "if (jsonData.access_token) {",
              "  pm.collectionVariables.set('token', jsonData.access_token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"cliente@raizes.com\",\n  \"senha\": \"Cliente@123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        }
      }
    },
    {
      "name": "Criar Usuário",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Novo Cliente\",\n  \"email\": \"novo.cliente@exemplo.com\",\n  \"senha\": \"Senha123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/usuarios",
          "host": ["{{baseUrl}}"],
          "path": ["usuarios"]
        }
      }
    },
    {
      "name": "Meu Usuário",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/usuarios/me",
          "host": ["{{baseUrl}}"],
          "path": ["usuarios", "me"]
        }
      }
    },
    {
      "name": "Teste Admin",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/usuarios/admin/teste",
          "host": ["{{baseUrl}}"],
          "path": ["usuarios", "admin", "teste"]
        }
      }
    },
    {
      "name": "Listar Unidades",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/unidades",
          "host": ["{{baseUrl}}"],
          "path": ["unidades"]
        }
      }
    },
    {
      "name": "Listar Produtos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/produtos",
          "host": ["{{baseUrl}}"],
          "path": ["produtos"]
        }
      }
    },
    {
      "name": "Listar Produtos por Unidade",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/produtos?unidadeId=1",
          "host": ["{{baseUrl}}"],
          "path": ["produtos"],
          "query": [
            { "key": "unidadeId", "value": "1" }
          ]
        }
      }
    },
    {
      "name": "Criar Pedido",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const jsonData = JSON.parse(responseBody);",
              "if (jsonData.pedidoId) {",
              "  pm.collectionVariables.set('pedidoId', String(jsonData.pedidoId));",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"unidadeId\": 1,\n  \"canalPedido\": \"APP\",\n  \"formaPagamento\": \"MOCK\",\n  \"itens\": [\n    {\n      \"produtoId\": 1,\n      \"quantidade\": 2\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/pedidos",
          "host": ["{{baseUrl}}"],
          "path": ["pedidos"]
        }
      }
    },
    {
      "name": "Listar Pedidos",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/pedidos",
          "host": ["{{baseUrl}}"],
          "path": ["pedidos"]
        }
      }
    },
    {
      "name": "Listar Pedidos com Filtro",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/pedidos?canalPedido=APP&status=AGUARDANDO_PAGAMENTO",
          "host": ["{{baseUrl}}"],
          "path": ["pedidos"],
          "query": [
            { "key": "canalPedido", "value": "APP" },
            { "key": "status", "value": "AGUARDANDO_PAGAMENTO" }
          ]
        }
      }
    },
    {
      "name": "Buscar Pedido por ID",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/pedidos/{{pedidoId}}",
          "host": ["{{baseUrl}}"],
          "path": ["pedidos", "{{pedidoId}}"]
        }
      }
    },
    {
      "name": "Processar Pagamento",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pedidoId\": 1,\n  \"resultado\": \"APROVADO\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/pagamentos",
          "host": ["{{baseUrl}}"],
          "path": ["pagamentos"]
        }
      }
    }
  ]
}